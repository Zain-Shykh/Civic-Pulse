# Copy to .env and fill in real values. .env itself is gitignored — never commit it.

# --- Postgres (compose.yaml, compose.prod.yaml) ---
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=civicpulse

# --- compose.yaml (dev) only: triage provider selection ---
# "rules" needs no API key and gives real-ish categorization for local dev; swap to "llm" (plus GEMINI_API_KEY) once you have a Gemini key.
TRIAGE_PROVIDER=rules

# --- compose.prod.yaml only: triage provider (required, no default — Compose itself errors if unset) ---
# Commented out on purpose: a real .env file has one active value per key, and
# the last uncommented assignment wins regardless of which comment header it
# sits under (confirmed via `docker compose config` — a literal `cp .env.example
# .env` used to silently resolve TRIAGE_PROVIDER=llm for the *dev* stack too,
# breaking the no-API-key-needed quickstart). Uncomment both lines and set a
# real GEMINI_API_KEY when actually running compose.prod.yaml; leaving them
# commented is what makes Compose's own ${VAR:?msg} fail loudly instead of
# silently deploying with a placeholder key.
# TRIAGE_PROVIDER=llm
# GEMINI_API_KEY=your-gemini-api-key-here

# --- compose.prod.yaml only: image source ---
# Real deployments set IMAGE_TAG to a commit SHA (docs/adr/0003-deploy-by-sha.md).
# "latest" here is a placeholder for local testing of the prod compose shape only —
# never what CI actually deploys.
GHCR_NAMESPACE=ghcr.io/OWNER
IMAGE_TAG=latest
